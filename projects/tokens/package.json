{
  "name": "@lifekit-hq/tokens",
  "version": "4.7.1",
  "description": "lifekit design tokens — CSS custom properties (light/dark themes), Tailwind preset, the seed engine that derives a whole palette from one colour, the self-hosted IBM Plex Sans and Plex Mono fonts, and the lifekit brand mark + browser-chrome standard. Framework-agnostic.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lifekit-hq/lifekit-common.git",
    "directory": "projects/tokens"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    "./theme.css": "./theme.css",
    "./fonts.css": "./fonts.css",
    "./base.css": "./base.css",
    "./carbon-bridge.css": "./carbon-bridge.css",
    "./tailwind": "./tailwind/preset.cjs",
    "./engine": {
      "types": "./engine/index.d.mts",
      "default": "./engine/index.mjs"
    },
    "./screen": {
      "types": "./screen/index.d.mts",
      "default": "./screen/index.mjs"
    },
    "./presets/*": "./presets/*",
    "./seeds/*": "./seeds/*",
    "./brand": "./brand/index.mjs",
    "./brand/vite": "./brand/vite.mjs",
    "./brand/theme-script": "./brand/theme-script.mjs",
    "./brand/*": "./brand/dist/*",
    "./whats-new": {
      "types": "./whats-new/parse.d.mts",
      "default": "./whats-new/parse.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "lifekit-chrome-check": "./bin/lifekit-chrome-check.mjs",
    "lifekit-theme-sync": "./bin/lifekit-theme-sync.mjs",
    "lifekit-whats-new": "./bin/lifekit-whats-new.mjs"
  },
  "files": [
    "theme.css",
    "fonts.css",
    "base.css",
    "carbon-bridge.css",
    "tailwind/",
    "engine/",
    "presets/",
    "seeds/",
    "brand/",
    "drift/",
    "icons/",
    "screen/",
    "whats-new/",
    "bin/",
    "LICENSES/",
    "NOTICE.md"
  ],
  "scripts": {
    "prepack": "node scripts/build-brand.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "axe-core": "~4.11.0"
  },
  "devDependencies": {
    "@carbon/styles": "^1.119.0",
    "sass": "^1.108.1"
  }
}
