{
  "name": "@lifekit-hq/tokens",
  "version": "2.1.0",
  "description": "lifekit design tokens — CSS custom properties (light/dark themes), Tailwind preset, the self-hosted IBM Plex Sans and Plex Mono fonts, and the lifekit brand mark + browser-chrome standard. Framework-agnostic.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lifekit-hq/lifekit-common.git",
    "directory": "projects/tokens"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    "./theme.css": "./theme.css",
    "./fonts.css": "./fonts.css",
    "./base.css": "./base.css",
    "./tailwind": "./tailwind/preset.cjs",
    "./brand": "./brand/index.mjs",
    "./brand/vite": "./brand/vite.mjs",
    "./brand/theme-script": "./brand/theme-script.mjs",
    "./brand/*": "./brand/dist/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "lifekit-chrome-check": "./bin/lifekit-chrome-check.mjs"
  },
  "files": [
    "theme.css",
    "fonts.css",
    "base.css",
    "tailwind/",
    "brand/",
    "drift/",
    "bin/",
    "LICENSES/",
    "NOTICE.md"
  ],
  "scripts": {
    "prepack": "node scripts/build-brand.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0"
  }
}
