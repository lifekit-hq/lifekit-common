{
  "name": "lifekit-common",
  "version": "0.2.1",
  "private": true,
  "description": "lifekit design system & Angular component library workspace",
  "scripts": {
    "ng": "ng",
    "build": "ng build @lifekit-hq/charts-core && ng build @lifekit-hq/elements && ng build @lifekit-hq/ui && ng build @lifekit-hq/core",
    "test": "ng test @lifekit-hq/charts-core --configuration ci && ng test @lifekit-hq/elements --configuration ci && ng test @lifekit-hq/ui --configuration ci && ng test @lifekit-hq/core --configuration ci",
    "lint": "ng lint",
    "format": "prettier --write \"projects/**/*.{ts,html,scss,css}\"",
    "format:check": "prettier --check \"projects/**/*.{ts,html,scss,css}\"",
    "storybook": "ng run \"@lifekit-hq/ui:storybook\"",
    "build-storybook": "ng run \"@lifekit-hq/ui:build-storybook\"",
    "check-strategy": "node scripts/check-strategy-coverage.mjs",
    "smoke:tokens": "node -e \"const p=require('./projects/tokens/tailwind/preset.cjs'); if(!p.theme) throw new Error('preset has no theme'); require('fs').accessSync('./projects/tokens/theme.css'); console.log('tokens ok')\"",
    "consumer-type-check": "bash fixtures/consumer-type-check/run.sh",
    "prepare": "husky"
  },
  "workspaces": [
    "projects/*"
  ],
  "dependencies": {
    "@angular/animations": "^21.2.5",
    "@angular/cdk": "^21.2.7",
    "@angular/common": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/forms": "^21.2.5",
    "@angular/platform-browser": "^21.2.5",
    "@angular/platform-browser-dynamic": "^21.2.5",
    "@angular/router": "^21.2.5",
    "@ngrx/signals": "^21.1.0",
    "@types/chroma-js": "^3.1.2",
    "chart.js": "^4.5.1",
    "chroma-js": "^3.2.0",
    "deep-chat": "^2.5.0",
    "lit": "^3.3.3",
    "lucide-angular": "^1.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2102.7",
    "@angular-devkit/build-angular": "^21.2.7",
    "@angular-devkit/core": "^21.2.7",
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.5",
    "@angular/language-service": "^21.2.5",
    "@playwright/test": "^1.62.1",
    "@smarttools/eslint-plugin-rxjs": "^1.0.22",
    "@storybook/angular": "^10.3.5",
    "@types/google.accounts": "^0.0.14",
    "@types/node": "^25.5.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "21.3.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^17.3.0",
    "ng-packagr": "^21.2.0",
    "postcss": "^8.5.9",
    "prettier": "^3.8.1",
    "storybook": "^10.3.5",
    "stylelint": "^17.6.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.0",
    "typescript-eslint": "8.56.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "projects/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "projects/**/*.{html,scss,css,json}": [
      "prettier --write"
    ]
  }
}
